<?xml version="1.0" encoding="utf-8"?>

<robot name="name" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Input parameter: NAME -->
  <xacro:arg name="name" default="ur5" />
  <!-- Input parameter: PREFIX -->
  <xacro:arg name="prefix" default="" />
  <xacro:property name="prefix" value="$(arg prefix)" />

  <!-- Planning Group: ROBOT ARM -->
  <group name="${prefix}ur5_arm">
    <chain base_link="${prefix}base_link" tip_link="${prefix}EE_robotiq_2f85" />
  </group>

  <!-- Planning Group: END EFFECTOR-->
  <group name="${prefix}robotiq_2f85">
    <joint name="${prefix}robotiq_coupler_joint" />
    <joint name="${prefix}robotiq_85_base_joint" />
    <joint name="${prefix}robotiq_85_left_knuckle_joint" />
    <joint name="${prefix}robotiq_85_right_knuckle_joint" />
    <joint name="${prefix}robotiq_85_left_finger_joint" />
    <joint name="${prefix}robotiq_85_right_finger_joint" />
    <joint name="${prefix}robotiq_85_left_inner_knuckle_joint" />
    <joint name="${prefix}robotiq_85_right_inner_knuckle_joint" />
    <joint name="${prefix}robotiq_85_left_finger_tip_joint" />
    <joint name="${prefix}robotiq_85_right_finger_tip_joint" />
  </group>

  <group_state group="${prefix}ur5_arm" name="home">
    <joint name="${prefix}elbow_joint" value="0" />
    <joint name="${prefix}shoulder_lift_joint" value="-1.5707" />
    <joint name="${prefix}shoulder_pan_joint" value="0" />
    <joint name="${prefix}wrist_1_joint" value="0" />
    <joint name="${prefix}wrist_2_joint" value="0" />
    <joint name="${prefix}wrist_3_joint" value="0" />
  </group_state>
  <group_state group="${prefix}ur5_arm" name="up">
    <joint name="${prefix}elbow_joint" value="0" />
    <joint name="${prefix}shoulder_lift_joint" value="-1.5707" />
    <joint name="${prefix}shoulder_pan_joint" value="0" />
    <joint name="${prefix}wrist_1_joint" value="-1.5707" />
    <joint name="${prefix}wrist_2_joint" value="0" />
    <joint name="${prefix}wrist_3_joint" value="0" />
  </group_state>
  <group_state name="GripperOpen" group="${prefix}robotiq_2f85">
    <joint name="${prefix}robotiq_85_left_knuckle_joint" value="0" />
    <joint name="${prefix}robotiq_85_right_knuckle_joint" value="0" />
    <joint name="${prefix}robotiq_85_left_inner_knuckle_joint" value="0" />
    <joint name="${prefix}robotiq_85_right_inner_knuckle_joint" value="0" />
    <joint name="${prefix}robotiq_85_left_finger_tip_joint" value="0" />
    <joint name="${prefix}robotiq_85_right_finger_tip_joint" value="0" />
  </group_state>
  <group_state name="GripperCloseHALF" group="${prefix}robotiq_2f85">
    <joint name="${prefix}robotiq_85_left_knuckle_joint" value="0.5" />
    <joint name="${prefix}robotiq_85_right_knuckle_joint" value="0.5" />
    <joint name="${prefix}robotiq_85_left_inner_knuckle_joint" value="0.5" />
    <joint name="${prefix}robotiq_85_right_inner_knuckle_joint" value="0.5" />
    <joint name="${prefix}robotiq_85_left_finger_tip_joint" value="-0.5" />
    <joint name="${prefix}robotiq_85_right_finger_tip_joint" value="-0.5" />
  </group_state>
  <group_state name="GripperCloseFULL" group="${prefix}robotiq_2f85">
    <joint name="${prefix}robotiq_85_left_knuckle_joint" value="0.8" />
    <joint name="${prefix}robotiq_85_right_knuckle_joint" value="0.8" />
    <joint name="${prefix}robotiq_85_left_inner_knuckle_joint" value="0.8" />
    <joint name="${prefix}robotiq_85_right_inner_knuckle_joint" value="0.8" />
    <joint name="${prefix}robotiq_85_left_finger_tip_joint" value="-0.8" />
    <joint name="${prefix}robotiq_85_right_finger_tip_joint" value="-0.8" />
  </group_state>

  <virtual_joint child_link="${prefix}base_link" name="${prefix}virtual_joint" parent_frame="world" type="fixed" />

  <disable_collisions link1="${prefix}base_link" link2="${prefix}base_link_inertia" reason="Adjacent" />
  <disable_collisions link1="${prefix}base_link_inertia" link2="${prefix}shoulder_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}wrist_1_link" reason="Never" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}wrist_2_link" reason="Never" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}wrist_3_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}forearm_link" link2="${prefix}upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}forearm_link" link2="${prefix}wrist_1_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}shoulder_link" link2="${prefix}upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}wrist_1_link" link2="${prefix}wrist_2_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}wrist_1_link" link2="${prefix}wrist_3_link" reason="Never" />
  <disable_collisions link1="${prefix}wrist_2_link" link2="${prefix}wrist_3_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}robotiq_85_base_link" reason="Never" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}robotiq_85_left_finger_link" reason="Never" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}robotiq_85_left_finger_tip_link" reason="Never" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}robotiq_85_left_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}robotiq_85_left_knuckle_link" reason="Never" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}robotiq_85_right_finger_link" reason="Never" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}robotiq_85_right_finger_tip_link" reason="Never" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}robotiq_85_right_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}robotiq_85_right_knuckle_link" reason="Never" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}robotiq_coupler" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_base_link" link2="${prefix}robotiq_85_left_finger_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_base_link" link2="${prefix}robotiq_85_left_finger_tip_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_base_link" link2="${prefix}robotiq_85_left_inner_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}robotiq_85_base_link" link2="${prefix}robotiq_85_left_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}robotiq_85_base_link" link2="${prefix}robotiq_85_right_finger_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_base_link" link2="${prefix}robotiq_85_right_finger_tip_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_base_link" link2="${prefix}robotiq_85_right_inner_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}robotiq_85_base_link" link2="${prefix}robotiq_85_right_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}robotiq_85_base_link" link2="${prefix}robotiq_coupler" reason="Adjacent" />
  <disable_collisions link1="${prefix}robotiq_85_base_link" link2="${prefix}wrist_1_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_base_link" link2="${prefix}wrist_2_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_base_link" link2="${prefix}wrist_3_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_link" link2="${prefix}robotiq_85_left_finger_tip_link" reason="Default" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_link" link2="${prefix}robotiq_85_left_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_link" link2="${prefix}robotiq_85_left_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_link" link2="${prefix}robotiq_85_right_finger_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_link" link2="${prefix}robotiq_85_right_finger_tip_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_link" link2="${prefix}robotiq_85_right_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_link" link2="${prefix}robotiq_85_right_knuckle_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_link" link2="${prefix}robotiq_coupler" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_link" link2="${prefix}wrist_1_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_link" link2="${prefix}wrist_2_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_link" link2="${prefix}wrist_3_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_tip_link" link2="${prefix}robotiq_85_left_inner_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_tip_link" link2="${prefix}robotiq_85_left_knuckle_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_tip_link" link2="${prefix}robotiq_85_right_finger_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_tip_link" link2="${prefix}robotiq_85_right_finger_tip_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_tip_link" link2="${prefix}robotiq_85_right_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_tip_link" link2="${prefix}robotiq_85_right_knuckle_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_tip_link" link2="${prefix}robotiq_coupler" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_left_finger_tip_link" link2="${prefix}wrist_1_link" reason="Never" />

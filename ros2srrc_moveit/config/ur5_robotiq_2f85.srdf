  <disable_collisions link1="${prefix}robotiq_85_left_knuckle_link" link2="${prefix}wrist_3_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_85_right_finger_link" link2="${prefix}robotiq_85_right_finger_tip_link" reason="Default" />
  <disable_collisions link1="${prefix}robotiq_85_right_finger_link" link2="${prefix}robotiq_85_right_inner_knuckle_link" reason="Never" />

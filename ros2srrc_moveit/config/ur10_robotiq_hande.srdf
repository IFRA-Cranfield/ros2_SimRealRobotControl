<robot name="$(arg name)" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Input parameter: NAME -->
  <xacro:arg name="name" default="ur10" />
  <!-- Input parameter: PREFIX -->
  <xacro:arg name="prefix" default="" />
  <xacro:property name="prefix" value="$(arg prefix)" />

  <group name="${prefix}ur10_arm">
    <chain base_link="${prefix}base_link" tip_link="${prefix}EE_robotiq_hande"/>
  </group>

  <group_state group="${prefix}ur10_arm" name="home">
    <joint name="${prefix}elbow_joint" value="0" />
    <joint name="${prefix}shoulder_lift_joint" value="-1.5707" />
    <joint name="${prefix}shoulder_pan_joint" value="0" />
    <joint name="${prefix}wrist_1_joint" value="0" />
    <joint name="${prefix}wrist_2_joint" value="0" />
    <joint name="${prefix}wrist_3_joint" value="0" />
  </group_state>

  <group_state group="${prefix}ur10_arm" name="up">
    <joint name="${prefix}elbow_joint" value="0" />
    <joint name="${prefix}shoulder_lift_joint" value="-1.5707" />
    <joint name="${prefix}shoulder_pan_joint" value="0" />
    <joint name="${prefix}wrist_1_joint" value="-1.5707" />
    <joint name="${prefix}wrist_2_joint" value="0" />
    <joint name="${prefix}wrist_3_joint" value="0" />
  </group_state>

  <virtual_joint child_link="${prefix}base_link" name="${prefix}virtual_joint" parent_frame="world" type="fixed"/>

  <disable_collisions link1="${prefix}base_link" link2="${prefix}base_link_inertia" reason="Adjacent" />
  <disable_collisions link1="${prefix}base_link_inertia" link2="${prefix}shoulder_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}wrist_1_link" reason="Never" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}wrist_2_link" reason="Never" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}wrist_3_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}forearm_link" link2="${prefix}upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}forearm_link" link2="${prefix}wrist_1_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}shoulder_link" link2="${prefix}upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}wrist_1_link" link2="${prefix}wrist_2_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}wrist_1_link" link2="${prefix}wrist_3_link" reason="Never" />
  <disable_collisions link1="${prefix}wrist_2_link" link2="${prefix}wrist_3_link" reason="Adjacent" />

  <disable_collisions link1="${prefix}tool0" link2="${prefix}robotiq_hande_base_link" reason="Never" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}robotiq_hande_left_finger" reason="Never" />
  <disable_collisions link1="${prefix}tool0" link2="${prefix}robotiq_hande_right_finger" reason="Never" />
  <!-- <disable_collisions link1="${prefix}tool0" link2="${prefix}robotiq_bracket" reason="Never" /> -->
  <disable_collisions link1="${prefix}tool0" link2="${prefix}robotiq_coupler" reason="Never" />

  <disable_collisions link1="${prefix}robotiq_hande_base_link" link2="${prefix}robotiq_hande_left_finger" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_hande_base_link" link2="${prefix}robotiq_hande_right_finger" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_hande_base_link" link2="${prefix}robotiq_coupler" reason="Adjacent" />
  <!-- <disable_collisions link1="${prefix}robotiq_hande_base_link" link2="${prefix}robotiq_bracket" reason="Never" /> -->
  <disable_collisions link1="${prefix}robotiq_hande_base_link" link2="${prefix}wrist_1_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_hande_base_link" link2="${prefix}wrist_2_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_hande_base_link" link2="${prefix}wrist_3_link" reason="Never" />

  <disable_collisions link1="${prefix}robotiq_hande_left_finger" link2="${prefix}robotiq_hande_right_finger" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_hande_left_finger" link2="${prefix}robotiq_coupler" reason="Never" />
  <!-- <disable_collisions link1="${prefix}robotiq_hande_left_finger" link2="${prefix}robotiq_bracket" reason="Never" /> -->
  <disable_collisions link1="${prefix}robotiq_hande_left_finger" link2="${prefix}wrist_1_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_hande_left_finger" link2="${prefix}wrist_2_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_hande_left_finger" link2="${prefix}wrist_3_link" reason="Never" />

  <disable_collisions link1="${prefix}robotiq_hande_right_finger" link2="${prefix}robotiq_hande_left_finger" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_hande_right_finger" link2="${prefix}robotiq_coupler" reason="Never" />
  <!-- <disable_collisions link1="${prefix}robotiq_hande_right_finger" link2="${prefix}robotiq_bracket" reason="Never" /> -->
  <disable_collisions link1="${prefix}robotiq_hande_right_finger" link2="${prefix}wrist_1_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_hande_right_finger" link2="${prefix}wrist_2_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_hande_right_finger" link2="${prefix}wrist_3_link" reason="Never" />

  <disable_collisions link1="${prefix}robotiq_coupler" link2="${prefix}wrist_1_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_coupler" link2="${prefix}wrist_2_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_coupler" link2="${prefix}wrist_3_link" reason="Adjacent" />

  <!-- <disable_collisions link1="${prefix}robotiq_bracket" link2="${prefix}wrist_1_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_bracket" link2="${prefix}wrist_2_link" reason="Never" />
  <disable_collisions link1="${prefix}robotiq_bracket" link2="${prefix}wrist_3_link" reason="Adjacent" /> -->

</robot>

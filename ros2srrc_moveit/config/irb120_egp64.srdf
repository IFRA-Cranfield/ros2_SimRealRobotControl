<?xml version="1.0" encoding="utf-8"?>

<robot name="irb120" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Input parameter: PREFIX -->
  <xacro:arg name="prefix" default="" />
  <xacro:property name="prefix" value="$(arg prefix)" />

  <!-- Planning Group: ROBOT ARM -->
  <group name="irb120_arm">
    <chain base_link="${prefix}base_link" tip_link="${prefix}EE_egp64" />
  </group>

  <group_state group="irb120_arm" name="all_zero">
    <joint name="${prefix}joint_1" value="0" />
    <joint name="${prefix}joint_2" value="0" />
    <joint name="${prefix}joint_3" value="0" />
    <joint name="${prefix}joint_4" value="0" />
    <joint name="${prefix}joint_5" value="0" />
    <joint name="${prefix}joint_6" value="0" />
  </group_state>

  <virtual_joint child_link="${prefix}base_link" name="${prefix}virtual_joint" parent_frame="world" type="fixed" />

  <disable_collisions link1="${prefix}base_link" link2="${prefix}link_1" reason="Adjacent" />
  <disable_collisions link1="${prefix}base_link" link2="${prefix}link_2" reason="Never" />
  <disable_collisions link1="${prefix}link_1" link2="${prefix}link_2" reason="Adjacent" />
  <disable_collisions link1="${prefix}link_2" link2="${prefix}link_3" reason="Adjacent" />
  <disable_collisions link1="${prefix}link_2" link2="${prefix}link_5" reason="Never" />
  <disable_collisions link1="${prefix}link_2" link2="${prefix}link_6" reason="Never" />
  <disable_collisions link1="${prefix}link_3" link2="${prefix}link_4" reason="Adjacent" />
  <disable_collisions link1="${prefix}link_3" link2="${prefix}link_5" reason="Never" />
  <disable_collisions link1="${prefix}link_3" link2="${prefix}link_6" reason="Never" />
  <disable_collisions link1="${prefix}link_4" link2="${prefix}link_5" reason="Adjacent" />
  <disable_collisions link1="${prefix}link_4" link2="${prefix}link_6" reason="Default" />
  <disable_collisions link1="${prefix}link_5" link2="${prefix}link_6" reason="Adjacent" />

  <!-- Planning Group: END EFFECTOR-->
  <group name="egp64">
    <joint name="${prefix}egp64_finger_left_joint" />
    <joint name="${prefix}egp64_finger_right_joint" />
  </group>

  <group_state name="gripper_open" group="egp64">
    <joint name="${prefix}egp64_finger_left_joint" value="0" />
    <joint name="${prefix}egp64_finger_right_joint" value="0" />
  </group_state>
  <group_state name="gripper_close_HALF" group="egp64">
    <joint name="${prefix}egp64_finger_left_joint" value="0.0135" />
    <joint name="${prefix}egp64_finger_right_joint" value="0.0135" />
  </group_state>
  <group_state name="gripper_close_FULL" group="egp64">
    <joint name="${prefix}egp64_finger_left_joint" value="0.027" />
    <joint name="${prefix}egp64_finger_right_joint" value="0.027" />
  </group_state>

  <disable_collisions link1="${prefix}egp64_finger_left_link" link2="${prefix}egp64_fingertip_left_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}egp64_finger_left_link" link2="${prefix}egp64_gripper_base_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}egp64_finger_left_link" link2="${prefix}schunk_coupler" reason="Never" />
  <disable_collisions link1="${prefix}egp64_finger_right_link" link2="${prefix}egp64_fingertip_right_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}egp64_finger_right_link" link2="${prefix}egp64_gripper_base_link" reason="Adjacent" />
  <disable_collisions link1="${prefix}egp64_finger_right_link" link2="${prefix}schunk_coupler" reason="Never" />
  <disable_collisions link1="${prefix}egp64_fingertip_left_link" link2="${prefix}egp64_gripper_base_link" reason="Never" />
  <disable_collisions link1="${prefix}egp64_fingertip_left_link" link2="${prefix}schunk_coupler" reason="Never" />
  <disable_collisions link1="${prefix}egp64_fingertip_right_link" link2="${prefix}egp64_gripper_base_link" reason="Never" />
  <disable_collisions link1="${prefix}egp64_fingertip_right_link" link2="${prefix}schunk_coupler" reason="Never" />
  <disable_collisions link1="${prefix}egp64_gripper_base_link" link2="${prefix}schunk_coupler" reason="Adjacent" />
  <disable_collisions link1="${prefix}link_6" link2="${prefix}schunk_coupler" reason="Adjacent" />

</robot>
<?xml version="1.0" encoding="utf-8"?>

<robot name="irb6640" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Input parameter: PREFIX -->
  <xacro:arg name="prefix" default="" />
  <xacro:property name="prefix" value="$(arg prefix)" />

  <!-- Planning Group: ROBOT ARM -->
  <group name="irb6640_arm">
    <chain base_link="${prefix}base_link" tip_link="${prefix}tool0" />
  </group>

  <group_state group="irb6640_arm" name="all_zero">
    <joint name="${prefix}joint_1" value="0" />
    <joint name="${prefix}joint_2" value="0" />
    <joint name="${prefix}joint_3" value="0" />
    <joint name="${prefix}joint_4" value="0" />
    <joint name="${prefix}joint_5" value="0" />
    <joint name="${prefix}joint_6" value="0" />
  </group_state>

  <virtual_joint child_link="${prefix}base_link" name="${prefix}virtual_joint" parent_frame="world" type="fixed" />

  <disable_collisions link1="${prefix}base_link" link2="${prefix}link_1" reason="Adjacent" />
  <disable_collisions link1="${prefix}base_link" link2="${prefix}link_2" reason="Never" />
  <disable_collisions link1="${prefix}link_1" link2="${prefix}link_2" reason="Adjacent" />
  <disable_collisions link1="${prefix}link_2" link2="${prefix}link_3" reason="Adjacent" />
  <disable_collisions link1="${prefix}link_2" link2="${prefix}link_5" reason="Never" />
  <disable_collisions link1="${prefix}link_2" link2="${prefix}link_6" reason="Never" />
  <disable_collisions link1="${prefix}link_3" link2="${prefix}link_4" reason="Adjacent" />
  <disable_collisions link1="${prefix}link_3" link2="${prefix}link_5" reason="Never" />
  <disable_collisions link1="${prefix}link_3" link2="${prefix}link_6" reason="Never" />
  <disable_collisions link1="${prefix}link_4" link2="${prefix}link_5" reason="Adjacent" />
  <disable_collisions link1="${prefix}link_4" link2="${prefix}link_6" reason="Default" />
  <disable_collisions link1="${prefix}link_5" link2="${prefix}link_6" reason="Adjacent" />
  <disable_collisions link1="${prefix}link_cylinder" link2="${prefix}link_piston" reason="Adjacent" />
  <disable_collisions link1="${prefix}base_link" link2="${prefix}link_cylinder" reason="Never" />
  <disable_collisions link1="${prefix}base_link" link2="${prefix}link_piston" reason="Never" />
  <disable_collisions link1="${prefix}link_1" link2="${prefix}link_cylinder" reason="Adjacent" />
  <disable_collisions link1="${prefix}link_1" link2="${prefix}link_piston" reason="Default" />
  <disable_collisions link1="${prefix}link_2" link2="${prefix}link_cylinder" reason="Adjacent" />
  <disable_collisions link1="${prefix}link_2" link2="${prefix}link_piston" reason="Adjacent" />
  <disable_collisions link1="${prefix}link_3" link2="${prefix}link_cylinder" reason="Never" />
  <disable_collisions link1="${prefix}link_3" link2="${prefix}link_piston" reason="Never" />
  <disable_collisions link1="${prefix}link_4" link2="${prefix}link_cylinder" reason="Never" />
  <disable_collisions link1="${prefix}link_4" link2="${prefix}link_piston" reason="Never" />
  <disable_collisions link1="${prefix}link_5" link2="${prefix}link_cylinder" reason="Never" />
  <disable_collisions link1="${prefix}link_5" link2="${prefix}link_piston" reason="Never" />
  <disable_collisions link1="${prefix}link_6" link2="${prefix}link_cylinder" reason="Never" />
  <disable_collisions link1="${prefix}link_6" link2="${prefix}link_piston" reason="Never" />

</robot>